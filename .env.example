PORT=3001

# Comma-separated list of allowed frontend origins (required for browsers)
# Local dev + production domain:
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://anfastyles.shop

# WooCommerce store (no trailing slash)
WC_STORE_URL=https://your-store.example
WC_CONSUMER_KEY=ck_...
WC_CONSUMER_SECRET=cs_....

# Stripe (test mode) - required for /payments/woopayments/intent
STRIPE_SECRET_KEY=sk_test_...
# Optional: create intents on a connected account (Stripe Connect request header)
STRIPE_ACCOUNT_ID=acct_...
# Optional default if frontend doesn't send currency
PAYMENT_CURRENCY=usd

